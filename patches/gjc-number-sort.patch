+fn session_number(title: &str) -> u64 {
+    let Some((prefix, suffix)) = title.trim_start().split_once('.') else {
+        return u64::MAX;
+    };
+    if prefix.is_empty()
+        || !prefix.bytes().all(|byte| byte.is_ascii_digit())
+        || !suffix.starts_with(char::is_whitespace)
+    {
+        return u64::MAX;
+    }
+    prefix
+        .parse::<u64>()
+        .ok()
+        .filter(|number| *number > 0)
+        .unwrap_or(u64::MAX)
+}
