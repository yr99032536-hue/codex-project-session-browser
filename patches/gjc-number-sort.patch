+#[test]
+fn project_sessions_sort_by_number_before_recency() {
+    let mut state = project_state();
+    state.all_rows = vec![
+        row("/tmp/ten.jsonl", Some("/work/alpha"), "10. Tenth", 100),
+        row("/tmp/two.jsonl", Some("/work/alpha"), "2. Second", 20),
+        row("/tmp/nine.jsonl", Some("/work/alpha"), "9. Ninth", 200),
+        row(
+            "/tmp/unnumbered.jsonl",
+            Some("/work/alpha"),
+            "Unnumbered",
+            300,
+        ),
+        row("/tmp/one.jsonl", Some("/work/alpha"), "1. First", 10),
+    ];
+    state.apply_filter();
+    assert_eq!(
+        state
+            .filtered_rows
+            .iter()
+            .map(Row::display_preview)
+            .collect::<Vec<_>>(),
+        vec![
+            "＋ 새 대화 시작",
+            "1. First",
+            "2. Second",
+            "9. Ninth",
+            "10. Tenth",
+            "Unnumbered"
+        ]
+    );
+    state.relative_time_reference = Utc.timestamp_opt(400, 0).single();
+    let width = 90;
+    let height = 16;
+    state.update_viewport(height.into(), width);
+    let mut terminal = Terminal::with_options(VT100Backend::new(width, height)).expect("terminal");
+    terminal.set_viewport_area(Rect::new(0, 0, width, height));
+    {
+        let mut frame = terminal.get_frame();
+        let area = frame.area();
+        render_list(&mut frame, area, &state);
+    }
+    terminal.flush().expect("flush");
+    insta::assert_snapshot!(
+        "resume_picker_numbered_project_sessions",
+        terminal.backend().to_string()
+    );
+}
+
