+use crate::resume_picker::SessionSelection;
+use crate::resume_picker::render_list;
+use crate::test_backend::VT100Backend;
+use crate::tui::FrameRequester;
+use codex_protocol::ThreadId;
+
+fn row(path: &str, cwd: Option<&str>, preview: &str, updated_at: i64) -> Row {
+    let timestamp = Utc.timestamp_opt(updated_at, 0).single();
+    Row {
+        path: Some(PathBuf::from(path)),
+        preview: preview.to_string(),
+        thread_id: None,
+        thread_name: None,
+        created_at: timestamp,
+        updated_at: timestamp,
+        cwd: cwd.map(PathBuf::from),
+        git_branch: None,
+    }
+}
+
+fn thread_row(thread_id: ThreadId, cwd: &str, preview: &str, updated_at: i64) -> Row {
+    let path = format!("/tmp/{thread_id}.jsonl");
+    let mut row = row(&path, Some(cwd), preview, updated_at);
+    row.thread_id = Some(thread_id);
+    row
+}
+
+fn desktop_project_browser(
+    thread_ids: &[ThreadId],
+    name: &str,
+    root_paths: &[&str],
+) -> (TempDir, ProjectBrowser) {
+    let codex_home = tempdir().expect("tempdir");
+    let assignments = thread_ids
+        .iter()
+        .map(|thread_id| {
+            (
+                thread_id.to_string(),
+                json!({"projectKind": "local", "projectId": "desktop-project"}),
+            )
+        })
+        .collect::<serde_json::Map<_, _>>();
+    fs::write(
+        codex_home.path().join(".codex-global-state.json"),
+        serde_json::to_vec(&json!({
+            "local-projects": {
+                "desktop-project": {
+                    "id": "desktop-project",
+                    "name": name,
+                    "rootPaths": root_paths
+                }
+            },
+            "project-order": ["desktop-project"],
+            "thread-project-assignments": assignments
+        }))
+        .expect("serialize state"),
+    )
+    .expect("write state");
+    let browser = ProjectBrowser::from_codex_home(SessionPickerAction::Resume, codex_home.path());
+    (codex_home, browser)
+}
+
+fn project_state() -> PickerState {
+    let loader: PickerLoader = Arc::new(|_| {});
+    let mut state = PickerState::new(
+        FrameRequester::test_dummy(),
+        loader,
+        ProviderFilter::MatchDefault(String::from("openai")),
+        /*show_all*/ true,
+        /*filter_cwd*/ None,
+        SessionPickerAction::Resume,
+    );
+    state.project_browser = ProjectBrowser::new(SessionPickerAction::Resume);
+    state.all_rows = vec![
+        row("/tmp/a.jsonl", Some("/work/alpha"), "First", 30),
+        row("/tmp/b.jsonl", Some("/work/alpha"), "Second", 20),
+        row("/tmp/c.jsonl", Some("/work/beta"), "Third", 10),
+    ];
+    state.apply_filter();
+    let project = state.filtered_rows[0].clone();
+    assert!(is_project_row(&project));
+    assert!(state.project_browser.enter(0));
+    state
+        .all_rows
+        .retain(|row| row.cwd.as_deref() == Some(Path::new("/work/alpha")));
+    state.allow_project_new_session = true;
+    state.apply_filter();
+    state
+}
