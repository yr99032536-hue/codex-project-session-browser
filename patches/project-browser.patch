+#[test]
+fn desktop_project_groups_assigned_sessions_across_working_directories() {
+    let first_thread_id = ThreadId::new();
+    let second_thread_id = ThreadId::new();
+    let (_codex_home, mut browser) = desktop_project_browser(
+        &[first_thread_id, second_thread_id],
+        "Desktop workspace",
+        &["/work/primary", "/work/secondary"],
+    );
+    let rows = [
+        thread_row(first_thread_id, "/generated/one", "First", 30),
+        thread_row(second_thread_id, "/work/secondary", "Second", 20),
+    ];
+
+    let overview = browser.overview_rows(rows.iter());
+
+    assert_eq!(overview.len(), 1);
+    assert_eq!(
+        overview[0].display_preview(),
+        "▸ Desktop workspace  ·  2 sessions"
+    );
+    assert_eq!(overview[0].cwd.as_deref(), Some(Path::new("/work/primary")));
+    assert!(browser.enter(0));
+    assert_eq!(browser.server_cwd_filter(), None);
+    assert_eq!(browser.selected_cwd(), Some(Path::new("/work/primary")));
+    let project_rows = browser.project_rows(rows.to_vec(), false);
+    assert_eq!(project_rows.len(), 2);
+    assert_eq!(project_rows[0].thread_id, Some(first_thread_id));
+    assert_eq!(project_rows[1].thread_id, Some(second_thread_id));
+}
