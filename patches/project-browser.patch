+#[test]
+fn project_can_be_entered_and_left() {
+    let mut browser = ProjectBrowser::new(SessionPickerAction::Resume);
+    let rows = [row("/tmp/a.jsonl", Some("/work/alpha"), "First", 30)];
+    browser.overview_rows(rows.iter());
+
+    assert!(browser.enter(0));
+    assert_eq!(browser.selected_cwd(), Some(Path::new("/work/alpha")));
+    assert_eq!(browser.selected_label(), Some("alpha"));
+    assert!(browser.back());
+    assert!(browser.is_overview());
+}
