+++ b/codex-rs/tui/src/resume_picker/project_browser.rs
@@ -0,0 +1,308 @@
+use std::collections::HashMap;
+use std::path::Path;
+use std::path::PathBuf;
+
+use chrono::DateTime;
+use chrono::Utc;
+
+use super::Row;
+use super::SessionPickerAction;
+use super::desktop_projects::DesktopProjectIndex;
+use crate::status::format_directory_display;
+
+const NEW_SESSION_PREVIEW: &str = "＋ 새 대화 시작";
+
+#[derive(Default)]
+pub(super) struct ProjectBrowser {
+    enabled: bool,
+    desktop_projects: DesktopProjectIndex,
+    overview_projects: Vec<Option<SelectedProject>>,
+    selected_project: Option<SelectedProject>,
+}
+
+#[derive(Clone)]
+struct SelectedProject {
+    key: ProjectKey,
+    cwd: Option<PathBuf>,
+    label: String,
+}
+
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+enum ProjectKey {
+    Desktop(String),
+    WorkingDirectory(PathBuf),
+}
+
+enum OverviewEntry {
+    Project(ProjectGroup),
+    Session(Row),
+}
+
+struct ProjectGroup {
+    key: ProjectKey,
+    cwd: Option<PathBuf>,
+    label: String,
+    session_count: usize,
+    created_at: Option<DateTime<Utc>>,
+    updated_at: Option<DateTime<Utc>>,
+}
+
+impl ProjectBrowser {
+    pub(super) fn new(action: SessionPickerAction) -> Self {
+        Self {
+            enabled: matches!(action, SessionPickerAction::Resume),
+            desktop_projects: DesktopProjectIndex::default(),
+            overview_projects: Vec::new(),
+            selected_project: None,
+        }
+    }
+
+    pub(super) fn from_codex_home(action: SessionPickerAction, codex_home: &Path) -> Self {
+        Self {
+            enabled: matches!(action, SessionPickerAction::Resume),
+            desktop_projects: DesktopProjectIndex::load(codex_home),
+            overview_projects: Vec::new(),
+            selected_project: None,
+        }
+    }
+
+    pub(super) fn is_enabled(&self) -> bool {
+        self.enabled
+    }
+
+    pub(super) fn is_overview(&self) -> bool {
+        self.enabled && self.selected_project.is_none()
+    }
+
+    pub(super) fn is_inside_project(&self) -> bool {
+        self.selected_project.is_some()
+    }
+
+    pub(super) fn selected_cwd(&self) -> Option<&Path> {
+        self.selected_project
+            .as_ref()
+            .and_then(|project| project.cwd.as_deref())
+    }
+
+    pub(super) fn server_cwd_filter(&self) -> Option<&Path> {
+        let project = self.selected_project.as_ref()?;
+        match &project.key {
+            ProjectKey::Desktop(_) => None,
+            ProjectKey::WorkingDirectory(_) => project.cwd.as_deref(),
+        }
+    }
+
+    pub(super) fn selected_label(&self) -> Option<&str> {
+        self.selected_project
+            .as_ref()
+            .map(|project| project.label.as_str())
+    }
+
+    pub(super) fn enter(&mut self, row_index: usize) -> bool {
+        if !self.is_overview() {
+            return false;
+        }
+        let Some(project) = self.overview_projects.get(row_index).cloned().flatten() else {
+            return false;
+        };
+        self.selected_project = Some(project);
+        true
+    }
+
+    pub(super) fn back(&mut self) -> bool {
+        self.selected_project.take().is_some()
+    }
+
+    pub(super) fn overview_rows<'a>(&mut self, rows: impl Iterator<Item = &'a Row>) -> Vec<Row> {
+        let mut entries = Vec::<OverviewEntry>::new();
+        let mut project_positions = HashMap::<ProjectKey, usize>::new();
+
+        for project in self.desktop_projects.projects_in_order() {
+            let key = ProjectKey::Desktop(project.id.clone());
+            project_positions.insert(key.clone(), entries.len());
+            entries.push(OverviewEntry::Project(ProjectGroup {
+                key,
+                cwd: project.root_paths.first().cloned(),
+                label: desktop_project_label(
+                    &project.name,
+                    project.root_paths.first().map(PathBuf::as_path),
+                    &project.id,
+                ),
+                session_count: 0,
+                created_at: project.created_at,
+                updated_at: project.updated_at,
+            }));
+        }
+
+        for row in rows {
+            let Some(key) = self.project_key(row) else {
+                entries.push(OverviewEntry::Session(row.clone()));
+                continue;
+            };
+
+            if let Some(position) = project_positions.get(&key).copied() {
+                let OverviewEntry::Project(project) = &mut entries[position] else {
+                    continue;
+                };
+                project.session_count = project.session_count.saturating_add(1);
+                project.created_at = latest(project.created_at, row.created_at);
+                project.updated_at = latest(project.updated_at, row.updated_at);
+                continue;
+            }
+
+            let ProjectKey::WorkingDirectory(cwd) = &key else {
+                continue;
+            };
+            let cwd = cwd.clone();
+            project_positions.insert(key.clone(), entries.len());
+            entries.push(OverviewEntry::Project(ProjectGroup {
+                key,
+                cwd: Some(cwd.clone()),
+                label: project_label(&cwd),
+                session_count: 1,
+                created_at: row.created_at,
+                updated_at: row.updated_at,
+            }));
+        }
+
+        self.overview_projects.clear();
+        entries
+            .into_iter()
+            .map(|entry| match entry {
+                OverviewEntry::Project(project) => {
+                    self.overview_projects.push(Some(project.selection()));
+                    project.into_row()
+                }
+                OverviewEntry::Session(row) => {
+                    self.overview_projects.push(None);
+                    row
+                }
+            })
+            .collect()
+    }
+
+    pub(super) fn project_rows(&self, rows: Vec<Row>, include_new_session: bool) -> Vec<Row> {
+        let Some(project) = self.selected_project.as_ref() else {
+            return rows;
+        };
+        let mut project_rows = rows
+            .into_iter()
+            .filter(|row| self.project_key(row).as_ref() == Some(&project.key))
+            .collect::<Vec<_>>();
+        if include_new_session && let Some(cwd) = project.cwd.as_ref() {
+            project_rows.insert(
+                0,
+                Row {
+                    path: None,
+                    preview: NEW_SESSION_PREVIEW.to_string(),
+                    thread_id: None,
+                    thread_name: None,
+                    created_at: None,
+                    updated_at: None,
+                    cwd: Some(cwd.clone()),
+                    git_branch: None,
+                },
+            );
+        }
+        project_rows
+    }
+
+    pub(super) fn new_session_cwd(&self, row: &Row) -> Option<PathBuf> {
+        if !self.is_inside_project() || !is_new_session_row(row) {
+            return None;
+        }
+        let selected_cwd = self.selected_cwd()?;
+        let row_cwd = row.cwd.as_deref()?;
+        (row_cwd == selected_cwd).then(|| selected_cwd.to_path_buf())
+    }
+
+    fn project_key(&self, row: &Row) -> Option<ProjectKey> {
+        if let Some(thread_id) = row.thread_id {
+            let thread_id = thread_id.to_string();
+            if let Some(project_id) = self.desktop_projects.project_id_for_thread(&thread_id)
+                && self.desktop_projects.project(project_id).is_some()
+            {
+                return Some(ProjectKey::Desktop(project_id.to_string()));
+            }
+            if self.desktop_projects.thread_has_assignment(&thread_id) {
+                return row.cwd.as_ref().cloned().map(ProjectKey::WorkingDirectory);
+            }
+        }
+        let cwd = row.cwd.as_ref()?;
+        self.desktop_projects
+            .project_id_for_root(cwd)
+            .map(|project_id| ProjectKey::Desktop(project_id.to_string()))
+            .or_else(|| Some(ProjectKey::WorkingDirectory(cwd.clone())))
+    }
+}
+
+impl ProjectGroup {
+    fn selection(&self) -> SelectedProject {
+        SelectedProject {
+            key: self.key.clone(),
+            cwd: self.cwd.clone(),
+            label: self.label.clone(),
+        }
+    }
+
+    fn into_row(self) -> Row {
+        let session_label = if self.session_count == 1 {
+            "session"
+        } else {
+            "sessions"
+        };
+        Row {
+            path: None,
+            preview: format!(
+                "▸ {}  ·  {} {session_label}",
+                self.label, self.session_count
+            ),
+            thread_id: None,
+            thread_name: None,
+            created_at: self.created_at,
+            updated_at: self.updated_at,
+            cwd: self.cwd,
+            git_branch: None,
+        }
+    }
+}
+
+pub(super) fn is_project_row(row: &Row) -> bool {
+    !is_new_session_row(row) && row.path.is_none() && row.thread_id.is_none()
+}
+
+pub(super) fn is_new_session_row(row: &Row) -> bool {
+    row.path.is_none()
+        && row.thread_id.is_none()
+        && row.cwd.is_some()
+        && row.preview == NEW_SESSION_PREVIEW
+}
+
+fn project_label(cwd: &Path) -> String {
+    cwd.file_name()
+        .and_then(|name| name.to_str())
+        .filter(|name| !name.is_empty())
+        .map(str::to_string)
+        .unwrap_or_else(|| format_directory_display(cwd, /*max_width*/ None))
+}
+
+fn desktop_project_label(name: &str, cwd: Option<&Path>, project_id: &str) -> String {
+    let name = name.trim();
+    if !name.is_empty() {
+        return name.to_string();
+    }
+    cwd.map(project_label)
+        .unwrap_or_else(|| project_id.to_string())
+}
+
+fn latest(left: Option<DateTime<Utc>>, right: Option<DateTime<Utc>>) -> Option<DateTime<Utc>> {
+    match (left, right) {
+        (Some(left), Some(right)) => Some(left.max(right)),
+        (Some(value), None) | (None, Some(value)) => Some(value),
+        (None, None) => None,
+    }
+}
+
+#[cfg(test)]
+#[path = "project_browser_tests.rs"]
+mod tests;
