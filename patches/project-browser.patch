@@ -0,0 +1,185 @@
+use std::collections::HashMap;
+use std::collections::HashSet;
+use std::fs;
+use std::path::Path;
+use std::path::PathBuf;
+
+use chrono::DateTime;
+use chrono::Utc;
+use serde::Deserialize;
+
+const DESKTOP_STATE_FILE: &str = ".codex-global-state.json";
+const MAX_DESKTOP_STATE_BYTES: u64 = 16 * 1024 * 1024;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub(super) struct DesktopProject {
+    pub(super) id: String,
+    pub(super) name: String,
+    pub(super) root_paths: Vec<PathBuf>,
+    pub(super) created_at: Option<DateTime<Utc>>,
+    pub(super) updated_at: Option<DateTime<Utc>>,
+}
+
+#[derive(Default)]
+pub(super) struct DesktopProjectIndex {
+    projects: HashMap<String, DesktopProject>,
+    project_order: Vec<String>,
+    thread_project_ids: HashMap<String, String>,
+    assigned_thread_ids: HashSet<String>,
+    root_project_ids: HashMap<PathBuf, Option<String>>,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default)]
+struct DesktopState {
+    #[serde(rename = "local-projects")]
+    local_projects: HashMap<String, DesktopProjectRecord>,
+    #[serde(rename = "project-order")]
+    project_order: Vec<String>,
+    #[serde(rename = "thread-project-assignments")]
+    thread_project_assignments: HashMap<String, DesktopProjectAssignment>,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+struct DesktopProjectRecord {
+    id: String,
+    name: String,
+    root_paths: Vec<PathBuf>,
+    created_at: Option<i64>,
+    updated_at: Option<i64>,
+}
+
+#[derive(Default, Deserialize)]
+#[serde(default, rename_all = "camelCase")]
+struct DesktopProjectAssignment {
+    project_kind: String,
+    project_id: String,
+}
+
+impl DesktopProjectIndex {
+    pub(super) fn load(codex_home: &Path) -> Self {
+        let state_path = codex_home.join(DESKTOP_STATE_FILE);
+        let backup_path = state_path.with_extension("json.bak");
+        [state_path, backup_path]
+            .into_iter()
+            .find_map(|path| load_state(&path))
+            .map(Self::from_state)
+            .unwrap_or_default()
+    }
+
+    pub(super) fn project(&self, project_id: &str) -> Option<&DesktopProject> {
+        self.projects.get(project_id)
+    }
+
+    pub(super) fn projects_in_order(&self) -> impl Iterator<Item = &DesktopProject> {
+        self.project_order
+            .iter()
+            .filter_map(|project_id| self.projects.get(project_id))
+    }
+
+    pub(super) fn project_id_for_thread(&self, thread_id: &str) -> Option<&str> {
+        self.thread_project_ids.get(thread_id).map(String::as_str)
+    }
+
+    pub(super) fn thread_has_assignment(&self, thread_id: &str) -> bool {
+        self.assigned_thread_ids.contains(thread_id)
+    }
+
+    pub(super) fn project_id_for_root(&self, root_path: &Path) -> Option<&str> {
+        self.root_project_ids
+            .get(root_path)
+            .and_then(Option::as_deref)
+    }
+
+    fn from_state(state: DesktopState) -> Self {
+        let projects = state
+            .local_projects
+            .into_iter()
+            .map(|(project_id, project)| {
+                let id = if project.id.is_empty() {
+                    project_id
+                } else {
+                    project.id
+                };
+                (
+                    id.clone(),
+                    DesktopProject {
+                        id,
+                        name: project.name,
+                        root_paths: project.root_paths,
+                        created_at: project.created_at.and_then(DateTime::from_timestamp_millis),
+                        updated_at: project.updated_at.and_then(DateTime::from_timestamp_millis),
+                    },
+                )
+            })
+            .collect::<HashMap<_, _>>();
+
+        let mut seen_project_ids = HashSet::new();
+        let mut project_order = state
+            .project_order
+            .into_iter()
+            .filter(|project_id| {
+                projects.contains_key(project_id) && seen_project_ids.insert(project_id.clone())
+            })
+            .collect::<Vec<_>>();
+        let mut remaining_project_ids = projects
+            .keys()
+            .filter(|project_id| !seen_project_ids.contains(*project_id))
+            .cloned()
+            .collect::<Vec<_>>();
+        remaining_project_ids.sort_by(|left, right| {
+            projects[left]
+                .name
+                .cmp(&projects[right].name)
+                .then_with(|| left.cmp(right))
+        });
+        project_order.extend(remaining_project_ids);
+
+        let mut assigned_thread_ids = HashSet::new();
+        let thread_project_ids = state
+            .thread_project_assignments
+            .into_iter()
+            .filter_map(|(thread_id, assignment)| {
+                assigned_thread_ids.insert(thread_id.clone());
+                (assignment.project_kind == "local"
+                    && projects.contains_key(&assignment.project_id))
+                .then_some((thread_id, assignment.project_id))
+            })
+            .collect();
+
+        let mut root_project_ids = HashMap::<PathBuf, Option<String>>::new();
+        for project in projects.values() {
+            for root_path in &project.root_paths {
+                root_project_ids
+                    .entry(root_path.clone())
+                    .and_modify(|project_id| {
+                        if project_id.as_deref() != Some(project.id.as_str()) {
+                            *project_id = None;
+                        }
+                    })
+                    .or_insert_with(|| Some(project.id.clone()));
+            }
+        }
+
+        Self {
+            projects,
+            project_order,
+            thread_project_ids,
+            assigned_thread_ids,
+            root_project_ids,
+        }
+    }
+}
+
+fn load_state(path: &Path) -> Option<DesktopState> {
+    let metadata = fs::metadata(path).ok()?;
+    if metadata.len() > MAX_DESKTOP_STATE_BYTES {
+        return None;
+    }
+    serde_json::from_slice(&fs::read(path).ok()?).ok()
+}
+
+#[cfg(test)]
+#[path = "desktop_projects_tests.rs"]
+mod tests;
