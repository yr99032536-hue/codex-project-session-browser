+#[test]
+fn unassigned_session_at_unique_project_root_joins_desktop_project() {
+    let (_codex_home, mut browser) =
+        desktop_project_browser(&[], "Desktop workspace", &["/work/primary"]);
+    let rows = [row(
+        "/tmp/unassigned.jsonl",
+        Some("/work/primary"),
+        "Created by CLI",
+        30,
+    )];
+
+    let overview = browser.overview_rows(rows.iter());
