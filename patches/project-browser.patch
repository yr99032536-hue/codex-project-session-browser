+use std::fs;
+use std::path::PathBuf;
+
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tempfile::tempdir;
+
+use super::DesktopProjectIndex;
+
+#[test]
+fn loads_projects_assignments_and_project_order() {
+    let codex_home = tempdir().expect("tempdir");
+    fs::write(
+        codex_home.path().join(".codex-global-state.json"),
+        serde_json::to_vec(&json!({
+            "local-projects": {
+                "project-a": {
+                    "id": "project-a",
+                    "name": "Alpha",
+                    "rootPaths": ["/work/alpha", "/work/shared"],
+                    "createdAt": 1_700_000_000_000_i64,
+                    "updatedAt": 1_700_000_001_000_i64
+                },
+                "project-b": {
+                    "id": "project-b",
+                    "name": "Beta",
+                    "rootPaths": []
+                }
+            },
+            "project-order": ["project-b", "project-a"],
+            "thread-project-assignments": {
+                "thread-a": {"projectKind": "local", "projectId": "project-a"},
+                "thread-remote": {"projectKind": "remote", "projectId": "project-a"},
+                "thread-missing": {"projectKind": "local", "projectId": "missing"}
+            }
+        }))
+        .expect("serialize state"),
+    )
+    .expect("write state");
+
+    let index = DesktopProjectIndex::load(codex_home.path());
+    let projects = index.projects_in_order().cloned().collect::<Vec<_>>();
+
+    assert_eq!(
+        projects
+            .iter()
+            .map(|project| project.id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["project-b", "project-a"]
+    );
+    assert_eq!(
+        projects[1].root_paths,
+        vec![PathBuf::from("/work/alpha"), PathBuf::from("/work/shared")]
+    );
+    assert_eq!(index.project_id_for_thread("thread-a"), Some("project-a"));
+    assert_eq!(index.project_id_for_thread("thread-remote"), None);
+    assert_eq!(index.project_id_for_thread("thread-missing"), None);
+    assert!(index.thread_has_assignment("thread-remote"));
+    assert!(index.thread_has_assignment("thread-missing"));
+    assert_eq!(
+        index.project_id_for_root(PathBuf::from("/work/shared").as_path()),
+        Some("project-a")
+    );
+}
+
+#[test]
+fn shared_root_path_is_not_assigned_to_one_project() {
+    let codex_home = tempdir().expect("tempdir");
+    fs::write(
+        codex_home.path().join(".codex-global-state.json"),
+        serde_json::to_vec(&json!({
+            "local-projects": {
+                "project-a": {"id": "project-a", "rootPaths": ["/work/shared"]},
+                "project-b": {"id": "project-b", "rootPaths": ["/work/shared"]}
+            }
+        }))
+        .expect("serialize state"),
+    )
+    .expect("write state");
+
+    let index = DesktopProjectIndex::load(codex_home.path());
+
+    assert_eq!(
+        index.project_id_for_root(PathBuf::from("/work/shared").as_path()),
+        None
+    );
+}
+
+#[test]
+fn falls_back_to_backup_when_primary_state_is_invalid() {
+    let codex_home = tempdir().expect("tempdir");
+    fs::write(
+        codex_home.path().join(".codex-global-state.json"),
+        b"not json",
+    )
+    .expect("write invalid state");
+    fs::write(
+        codex_home.path().join(".codex-global-state.json.bak"),
+        serde_json::to_vec(&json!({
+            "local-projects": {
+                "project-a": {
+                    "id": "project-a",
+                    "name": "Recovered",
+                    "rootPaths": ["/work/recovered"]
+                }
+            }
+        }))
+        .expect("serialize backup"),
+    )
+    .expect("write backup");
+
+    let index = DesktopProjectIndex::load(codex_home.path());
+
+    assert_eq!(
+        index
+            .project("project-a")
+            .map(|project| project.name.as_str()),
+        Some("Recovered")
+    );
+}
+
+#[test]
+fn missing_state_uses_an_empty_index() {
+    let codex_home = tempdir().expect("tempdir");
+
+    let index = DesktopProjectIndex::load(codex_home.path());
+
+    assert_eq!(index.projects_in_order().count(), 0);
+    assert_eq!(index.project_id_for_thread("thread-a"), None);
+}
