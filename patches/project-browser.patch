+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use chrono::TimeZone;
+use chrono::Utc;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use ratatui::layout::Rect;
+
+use super::ProjectBrowser;
+use super::is_new_session_row;
+use super::is_project_row;
+use crate::custom_terminal::Terminal;
+use crate::resume_picker::PickerLoader;
+use crate::resume_picker::PickerState;
+use crate::resume_picker::ProviderFilter;
+use crate::resume_picker::Row;
+use crate::resume_picker::SessionPickerAction;
+use crate::resume_picker::SessionSelection;
+use crate::resume_picker::render_list;
+use crate::test_backend::VT100Backend;
+use crate::tui::FrameRequester;
+
+fn row(path: &str, cwd: Option<&str>, preview: &str, updated_at: i64) -> Row {
+    let timestamp = Utc.timestamp_opt(updated_at, 0).single();
+    Row {
+        path: Some(PathBuf::from(path)),
+        preview: preview.to_string(),
+        thread_id: None,
+        thread_name: None,
+        created_at: timestamp,
+        updated_at: timestamp,
+        cwd: cwd.map(PathBuf::from),
+        git_branch: None,
+    }
+}
+
+fn project_state() -> PickerState {
+    let loader: PickerLoader = Arc::new(|_| {});
+    let mut state = PickerState::new(
+        FrameRequester::test_dummy(),
+        loader,
+        ProviderFilter::MatchDefault(String::from("openai")),
+        /*show_all*/ true,
+        /*filter_cwd*/ None,
+        SessionPickerAction::Resume,
+    );
+    state.project_browser = ProjectBrowser::new(SessionPickerAction::Resume);
+    state.all_rows = vec![
+        row("/tmp/a.jsonl", Some("/work/alpha"), "First", 30),
+        row("/tmp/b.jsonl", Some("/work/alpha"), "Second", 20),
+        row("/tmp/c.jsonl", Some("/work/beta"), "Third", 10),
+    ];
+    state.apply_filter();
+    let project = state.filtered_rows[0].clone();
+    assert!(state.project_browser.enter(&project));
+    state
+        .all_rows
+        .retain(|row| row.cwd.as_deref() == Some(Path::new("/work/alpha")));
+    state.allow_project_new_session = true;
+    state.apply_filter();
+    state
+}
+
+#[test]
+fn overview_groups_sessions_by_working_directory() {
+    let browser = ProjectBrowser::new(SessionPickerAction::Resume);
+    let rows = [
+        row("/tmp/a.jsonl", Some("/work/alpha"), "First", 30),
+        row("/tmp/b.jsonl", Some("/work/beta"), "Second", 20),
+        row("/tmp/c.jsonl", Some("/work/alpha"), "Third", 10),
+        row("/tmp/d.jsonl", None, "Unscoped", 5),
+    ];
+
+    let overview = browser.overview_rows(rows.iter());
+
+    assert_eq!(overview.len(), 3);
+    assert!(is_project_row(&overview[0]));
+    assert_eq!(overview[0].display_preview(), "▸ alpha  ·  2 sessions");
+    assert!(is_project_row(&overview[1]));
+    assert_eq!(overview[1].display_preview(), "▸ beta  ·  1 session");
+    assert_eq!(overview[2].display_preview(), "Unscoped");
+}
+
+#[test]
+fn project_rows_start_with_new_session_action() {
+    let state = project_state();
+
+    assert!(is_new_session_row(&state.filtered_rows[0]));
+    assert_eq!(state.filtered_rows[0].display_preview(), "＋ 새 대화 시작");
+    assert_eq!(
+        state
+            .project_browser
+            .new_session_cwd(&state.filtered_rows[0]),
+        Some(PathBuf::from("/work/alpha"))
+    );
+}
+
+#[tokio::test]
+async fn accepting_new_session_action_returns_selected_project_cwd() {
+    let mut state = project_state();
+
+    let selection = state
+        .handle_key(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE))
+        .await
+        .expect("handle enter");
+
+    assert!(matches!(selection, Some(SessionSelection::StartFresh)));
+    assert_eq!(state.new_session_cwd, Some(PathBuf::from("/work/alpha")));
+}
+
+#[test]
+fn project_can_be_entered_and_left() {
+    let mut browser = ProjectBrowser::new(SessionPickerAction::Resume);
+    let rows = [row("/tmp/a.jsonl", Some("/work/alpha"), "First", 30)];
+    let overview = browser.overview_rows(rows.iter());
+
+    assert!(browser.enter(&overview[0]));
+    assert_eq!(browser.selected_cwd(), Some(Path::new("/work/alpha")));
+    assert_eq!(browser.selected_label(), Some("alpha"));
+    assert!(browser.back());
+    assert!(browser.is_overview());
+}
+
+#[test]
+fn fork_picker_keeps_the_flat_session_list() {
+    let browser = ProjectBrowser::new(SessionPickerAction::Fork);
+
+    assert!(!browser.is_enabled());
+    assert!(!browser.is_overview());
+}
+
+#[test]
+fn project_sessions_snapshot() {
+    let mut state = project_state();
+    state.relative_time_reference = Utc.timestamp_opt(40, 0).single();
+    state.update_viewport(/*rows*/ 8, /*width*/ 80);
+
+    let width = 80;
+    let height = 8;
+    let backend = VT100Backend::new(width, height);
+    let mut terminal = Terminal::with_options(backend).expect("terminal");
+    terminal.set_viewport_area(Rect::new(0, 0, width, height));
+
+    {
+        let mut frame = terminal.get_frame();
+        let area = frame.area();
+        render_list(&mut frame, area, &state);
+    }
+    terminal.flush().expect("flush");
+
+    insta::assert_snapshot!(
+        "resume_picker_project_sessions_with_new_action",
+        terminal.backend().to_string()
+    );
+}
