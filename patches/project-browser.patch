+    assert_eq!(overview.len(), 1);
+    assert_eq!(
+        overview[0].display_preview(),
+        "▸ Desktop workspace  ·  1 session"
+    );
+    assert!(browser.enter(0));
+    assert_eq!(browser.project_rows(rows.to_vec(), false).len(), 1);
+}
