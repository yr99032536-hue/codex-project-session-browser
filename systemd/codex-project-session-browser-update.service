[Unit]
Description=Update Codex and rebuild the project session browser
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="PATH=%h/.cargo/bin:%h/.local/bin:%h/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=%h/.local/share/codex-project-session-browser/manager/update-and-verify.sh
